project_id       = "my-gcp-project"
region           = "us-central1"
zone             = "us-central1-a"
domain           = "hangar.example.com"
enable_kata_pool = false

# Sandbox nodes off 1 AM - 9:50 AM, ready with a warm node by 10 (deploy/gke/power.sh on Cloud Scheduler);
# hangar and the system pool stay up
# enable_power_schedule = true
# power_up_cron         = "50 9 * * *"
# power_warm_minutes    = 10
# power_down_cron       = "0 1 * * *"
# power_time_zone       = "America/New_York"
# sandbox_warm_nodes    = 1
# power_deploy_repo     = "OWNER/REPO"   # public: after the power-up, hangar shows when main is ahead of it

# Run capture (outbox.tf, on by default): flightdeck's nightly compactor reads the run bucket. Its
# deploy/compactor/setup.sh creates this account and grants it read on the bucket; list it here once it exists.
# run_bucket_readers = ["serviceAccount:flightdeck-compactor@my-gcp-project.iam.gserviceaccount.com"]
